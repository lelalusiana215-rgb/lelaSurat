rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /test/{document} {
      allow read, write: if true;
    }
    match /school_data/{document} {
      allow read, write: if true;
    }
    match /surat_history/{document} {
      allow read, write: if true;
    }
  }
}
